# Copia este archivo como «.env» y ajusta la dirección del backend.
# Tras cambiarla hay que reiniciar «npm run dev»: Vite solo lee el archivo al arrancar.

# Backend en este computador (uvicorn app.main:app --port 8000)
VITE_API_URL=http://localhost:8000

# Backend en Google Cloud Run (la dirección que entrega «gcloud run deploy», sin barra al final)
# VITE_API_URL=https://centinelas-api-XXXXXXXX.a.run.app

# En Vercel no se usa este archivo: la misma variable se define en
# Project Settings → Environment Variables.
